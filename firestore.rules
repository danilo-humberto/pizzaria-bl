rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    function hasPizzaSelectionLists(data) {
      return data.keys().hasAll(['pizzaFlavorIds', 'borderIds', 'esfihaIds', 'beverageIds'])
        && data.pizzaFlavorIds is list
        && data.borderIds is list
        && data.esfihaIds is list
        && data.beverageIds is list;
    }

    function hasValidAvailabilityShape() {
      let data = request.resource.data;
      return data.keys().hasAll(['updatedAt', 'updatedBy'])
        && data.keys().hasOnly(['pizzaFlavorIds', 'borderIds', 'esfihaIds', 'beverageIds', 'updatedAt', 'updatedBy'])
        && hasPizzaSelectionLists(data)
        && data.updatedAt is timestamp
        && data.updatedBy == request.auth.uid;
    }

    // Paridade com o açaí: valida o envelope e os IDs declarados.
    // Preços, quantidades e correspondência entre linhas e IDs são validados no cliente.
    function hasValidPizzaItems(items) {
      return items is map
        && items.keys().hasAll(['lines', 'observation'])
        && items.keys().hasOnly(['lines', 'observation', 'pizzaFlavorIds', 'borderIds', 'esfihaIds', 'beverageIds'])
        && items.lines is list
        && items.lines.size() > 0
        && items.observation is string
        && hasPizzaSelectionLists(items)
        && items.pizzaFlavorIds.size() + items.esfihaIds.size() + items.beverageIds.size() > 0;
    }

    function selectedItemsAreAvailable() {
      return !exists(/databases/$(database)/documents/storeSettings/pizzaAvailability) || (
        !request.resource.data.items.pizzaFlavorIds.hasAny(get(/databases/$(database)/documents/storeSettings/pizzaAvailability).data.pizzaFlavorIds)
        && !request.resource.data.items.borderIds.hasAny(get(/databases/$(database)/documents/storeSettings/pizzaAvailability).data.borderIds)
        && !request.resource.data.items.esfihaIds.hasAny(get(/databases/$(database)/documents/storeSettings/pizzaAvailability).data.esfihaIds)
        && !request.resource.data.items.beverageIds.hasAny(get(/databases/$(database)/documents/storeSettings/pizzaAvailability).data.beverageIds)
      );
    }

    function hasValidNewOrderShape(orderId) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'schemaVersion', 'publicCode', 'trackingCode', 'status', 'customer',
          'fulfillment', 'items', 'payment', 'total', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'schemaVersion', 'publicCode', 'trackingCode', 'status', 'customer',
          'fulfillment', 'items', 'payment', 'total', 'createdAt', 'updatedAt'
        ])
        && data.schemaVersion == 1
        && data.trackingCode == orderId
        && data.status == 'received'
        && data.publicCode is string && data.publicCode.size() > 0
        && data.trackingCode is string
        && data.fulfillment == 'pickup'
        && data.customer is map
        && data.customer.keys().hasAll(['name', 'phone'])
        && data.customer.keys().hasOnly(['name', 'phone'])
        && data.customer.name is string && data.customer.name.size() > 0
        && data.customer.phone is string && data.customer.phone.size() > 0
        && hasValidPizzaItems(data.items)
        && data.payment is map
        && data.payment.keys().hasAll(['method', 'needsChange'])
        && data.payment.keys().hasOnly(['method', 'needsChange', 'changeFor'])
        && data.payment.method in ['pix', 'card', 'cash']
        && data.payment.needsChange is bool
        && (!('changeFor' in data.payment) || data.payment.changeFor is number)
        && data.total is number && data.total >= 0
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    match /admins/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    match /storeSettings/pizzaAvailability {
      allow read: if true;
      allow create, update: if isAdmin() && hasValidAvailabilityShape();
      allow delete: if false;
    }

    match /orders/{orderId} {
      // Mantém o acompanhamento por link do modelo original.
      allow get: if true;
      allow list: if isAdmin();
      allow create: if hasValidNewOrderShape(orderId) && selectedItemsAreAvailable();
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
